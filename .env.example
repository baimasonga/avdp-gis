# =====================================================================
# AVDP GIS Portal - environment template
# =====================================================================
# Do NOT commit a filled-in copy of this file. `.env` is git-ignored.
#
# Generate a local .env with random secrets:
#     python3 create-envfile.py --noinput --env_type=dev --hostname=localhost
# then review it. Placeholders in {braces} are substituted by that script;
# any placeholder not supplied on the command line gets a random value.
#
# Values marked [SECRET] must be unique, random and kept out of Git.
# =====================================================================

# Prefix for container, image and volume names. Changing it after the first
# start creates a new, empty set of volumes.
COMPOSE_PROJECT_NAME=avdp_gis
DOCKER_ENV=production
BACKUPS_VOLUME_DRIVER=local

# ---------------------------------------------------------------------
# Pinned versions (GeoNode 5.1.1 / geonode-project 5.1.x combination).
# Upstream tags ending in "-latest" can be rebuilt by GeoNode maintainers,
# so each image is additionally pinned by digest. Update tag AND digest
# together, and only to combinations documented for the GeoNode release.
# ---------------------------------------------------------------------
# Tag used for the locally built application image
GEONODE_BASE_IMAGE_VERSION=5.1.1-avdp
# Upstream base image used to build the application image
GEONODE_BASE_IMAGE=geonode/geonode-base:latest-ubuntu-24.04@sha256:11d2602da6120dc764149ae74063755587960107fa407b0e1bbb77c8eac1767f
NGINX_BASE_IMAGE_VERSION=1.31.7-latest
NGINX_BASE_IMAGE_DIGEST=sha256:564ac7efaa608d7d0e61f189ace941efe575147d1d40a706aa36ce85cc5b19ea
GEOSERVER_BASE_IMAGE_VERSION=2.28.6-latest
GEOSERVER_BASE_IMAGE_DIGEST=sha256:edac284ca49fd5c4b39699bff17e2229bdcd20d7224aa42c2322ed28344e70a4
GEOSERVER_DATA_BASE_IMAGE_VERSION=2.28.6-latest
GEOSERVER_DATA_BASE_IMAGE_DIGEST=sha256:7e450fd34987541ea2411a7131472c897bd6331936e9ca161fa5966b7928fab4
POSTGRES_BASE_IMAGE_VERSION=15-3.5-latest
POSTGRES_BASE_IMAGE_DIGEST=sha256:ff301c2c99b608577d0bcd44b43f90c34c828113659bc57b0b5df36c47ac7576
# letsencrypt is only used with `--profile https`; pin its digest before production use.
LETSENCRYPT_BASE_IMAGE_VERSION=2.6.0-latest
REDIS_IMAGE=redis:7-alpine@sha256:8da19c7399dca900c6822a1cf30f9d2285585e2c4b457ff4095b0f4500054d3f
MEMCACHED_IMAGE=memcached:1.6-alpine@sha256:6a089e37cbb8acd75c80c6c0667fe57ec54db68782fb1b3afb1d0eb265e50070

C_FORCE_ROOT=1
# Set to true to re-run fixtures and reset the admin password from
# ADMIN_PASSWORD on the next start. Leave false normally.
FORCE_REINIT=false
INVOKE_LOG_STDOUT=true

DJANGO_SETTINGS_MODULE=geonode_project.settings
GEONODE_INSTANCE_NAME=geonode
SITENAME="AVDP GIS Portal"
LANGUAGE_CODE=en

# ---------------------------------------------------------------------
# Database (PostgreSQL + PostGIS, internal to the Docker network)
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
# [SECRET]
POSTGRES_PASSWORD={pgpwd}
GEONODE_DATABASE=geonode_project
GEONODE_DATABASE_USER=geonode_project
# [SECRET]
GEONODE_DATABASE_PASSWORD={dbpwd}
GEONODE_GEODATABASE=geonode_project_data
GEONODE_GEODATABASE_USER=geonode_project_data
# [SECRET]
GEONODE_GEODATABASE_PASSWORD={geodbpwd}
GEONODE_DATABASE_SCHEMA=public
GEONODE_GEODATABASE_SCHEMA=public
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_URL=postgis://geonode_project:{dbpwd}@db:5432/geonode_project
GEODATABASE_URL=postgis://geonode_project_data:{geodbpwd}@db:5432/geonode_project_data
GEONODE_DB_CONN_MAX_AGE=0
GEONODE_DB_CONN_TOUT=5
DEFAULT_BACKEND_DATASTORE=datastore
POSTGRESQL_MAX_CONNECTIONS=200

# ---------------------------------------------------------------------
# Background processing (Celery + Redis)
# ---------------------------------------------------------------------
BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_BEAT_SCHEDULER=celery.beat:PersistentScheduler
ASYNC_SIGNALS=True

# ---------------------------------------------------------------------
# Public URL
# ---------------------------------------------------------------------
SITEURL={siteurl}/
ALLOWED_HOSTS="['django', '{hostname}']"

# Data uploader
DEFAULT_BACKEND_UPLOADER=geonode.importer
TIME_ENABLED=True
MOSAIC_ENABLED=False
HAYSTACK_SEARCH=False
HAYSTACK_ENGINE_URL=http://elasticsearch:9200/
HAYSTACK_ENGINE_INDEX_NAME=haystack
HAYSTACK_SEARCH_RESULTS_PER_PAGE=200

# ---------------------------------------------------------------------
# Nginx
# ---------------------------------------------------------------------
GEONODE_LB_HOST_IP=django
GEONODE_LB_PORT=8000
NGINX_BASE_URL={siteurl}
# Interface the published ports bind to. 127.0.0.1 = this machine only.
# Use 0.0.0.0 only on a firewalled server (see docs/DEPLOYMENT.md).
HTTP_BIND=127.0.0.1
# Leave HTTPS_HOST empty for HTTP-only local development.
HTTP_HOST={http_host}
HTTPS_HOST={https_host}
HTTP_PORT=80
HTTPS_PORT=443
# disabled | staging | production  (requires a public DNS name for HTTPS_HOST)
LETSENCRYPT_MODE={letsencrypt_mode}
RESOLVER=127.0.0.11

# ---------------------------------------------------------------------
# GeoServer
# ---------------------------------------------------------------------
GEOSERVER_LB_HOST_IP=geoserver
GEOSERVER_LB_PORT=8080
GEOSERVER_WEB_UI_LOCATION={siteurl}/geoserver/
GEOSERVER_PUBLIC_LOCATION={siteurl}/geoserver/
GEOSERVER_LOCATION=http://${GEOSERVER_LB_HOST_IP}:${GEOSERVER_LB_PORT}/geoserver/
GEOSERVER_ADMIN_USER=admin
# [SECRET]
GEOSERVER_ADMIN_PASSWORD={geoserverpwd}

OGC_REQUEST_TIMEOUT=30
OGC_REQUEST_MAX_RETRIES=1
OGC_REQUEST_BACKOFF_FACTOR=0.3
OGC_REQUEST_POOL_MAXSIZE=10
OGC_REQUEST_POOL_CONNECTIONS=10

# Java options. 2 GB heap is enough for development; use 4 GB+ in production.
ENABLE_JSONP=true
outFormat=text/javascript
GEOSERVER_JAVA_OPTS="-Djava.awt.headless=true -Xms1G -Xmx2G -Dgwc.context.suffix=gwc -XX:+UnlockDiagnosticVMOptions -XX:+LogVMOutput -XX:LogFile=/var/log/jvm.log -XX:PerfDataSamplingInterval=500 -XX:SoftRefLRUPolicyMSPerMB=36000 -XX:-UseGCOverheadLimit -XX:ParallelGCThreads=4 -Dfile.encoding=UTF8 -Djavax.servlet.request.encoding=UTF-8 -Djavax.servlet.response.encoding=UTF-8 -Duser.timezone=GMT -Dorg.geotools.shapefile.datetime=false -DGS-SHAPEFILE-CHARSET=UTF-8 -DGEOSERVER_CSRF_DISABLED=true -DPRINT_BASE_URL={siteurl}/geoserver/pdf -DALLOW_ENV_PARAMETRIZATION=true -Xbootclasspath/a:/usr/local/tomcat/webapps/geoserver/WEB-INF/lib/marlin-0.9.3-Unsafe.jar -Dsun.java2d.renderer=org.marlin.pisces.MarlinRenderingEngine"

# ---------------------------------------------------------------------
# Administrator
# ---------------------------------------------------------------------
# ADMIN_PASSWORD is applied ONLY on the first start (or when FORCE_REINIT=true).
# Change it in the portal after first sign-in; see README.md.
ADMIN_USERNAME=admin
# [SECRET]
ADMIN_PASSWORD={geonodepwd}
ADMIN_EMAIL={email}

# Email notifications (disabled until an SMTP relay is configured)
EMAIL_ENABLE=False
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=False
DJANGO_EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL='{email}'

# ---------------------------------------------------------------------
# Access control - AVDP defaults: private until deliberately published
# ---------------------------------------------------------------------
LOCKDOWN_GEONODE=False
X_FRAME_OPTIONS="SAMEORIGIN"
SESSION_ENGINE=django.contrib.sessions.backends.cached_db
SESSION_EXPIRED_CONTROL_ENABLED=True
# Default permissions applied to NEW resources (GeoNode 5.1 compact syntax).
# anonymous:          view | download | none   (upstream default: download)
# registered members: view | download | edit | manage | none (upstream: download)
# AVDP: new uploads are private to their owner (and administrators) until
# the owner deliberately shares them with users/groups or makes them public.
DEFAULT_ANONYMOUS_PERMISSIONS=none
DEFAULT_REGISTERED_MEMBERS_PERMISSIONS=none
# Only owners/managers may change public access of their resources.
EDITORS_CAN_MANAGE_ANONYMOUS_PERMISSIONS=False
EDITORS_CAN_MANAGE_REGISTERED_MEMBERS_PERMISSIONS=False

# Session/CSRF cookies are sent only over HTTPS (GeoNode default). Browsers
# make an exception for http://localhost, so local development works as is.
# Set both to False ONLY for plain-HTTP testing on another host name/IP.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

CORS_ALLOW_ALL_ORIGINS=False
GEOSERVER_CORS_ENABLED=True
GEOSERVER_CORS_ALLOWED_ORIGINS={siteurl}
GEOSERVER_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,HEAD,OPTIONS
GEOSERVER_CORS_ALLOWED_HEADERS=*

# Self-registration is closed: administrators create accounts.
ACCOUNT_OPEN_SIGNUP=False
ACCOUNT_EMAIL_REQUIRED=True
ACCOUNT_APPROVAL_REQUIRED=True
ACCOUNT_CONFIRM_EMAIL_ON_GET=False
ACCOUNT_EMAIL_VERIFICATION=none
ACCOUNT_AUTHENTICATION_METHOD=username_email
AUTO_ASSIGN_REGISTERED_MEMBERS_TO_REGISTERED_MEMBERS_GROUP_NAME=True
# Upload rights are NOT given to every new account. Editors get them through
# the "avdp-editors" group (created by `python manage.py avdp_setup`).
AUTO_ASSIGN_REGISTERED_MEMBERS_TO_CONTRIBUTORS=False

# OAuth2 between GeoNode and GeoServer
OAUTH2_API_KEY=
# [SECRET]
OAUTH2_CLIENT_ID={clientid}
# [SECRET]
OAUTH2_CLIENT_SECRET={clientsecret}

# GeoNode APIs
API_LOCKDOWN=False
TASTYPIE_APIKEY=

# Set DEBUG=False for anything other than local development.
DEBUG={debug}

# [SECRET]
SECRET_KEY='{secret_key}'

STATIC_ROOT=/mnt/volumes/statics/static/
MEDIA_ROOT=/mnt/volumes/statics/uploaded/
ASSETS_ROOT=/mnt/volumes/statics/assets/
GEOIP_PATH=/mnt/volumes/statics/geoip.db

CACHE_BUSTING_STATIC_ENABLED=False

MEMCACHED_ENABLED=False
MEMCACHED_BACKEND=django.core.cache.backends.memcached.PyLibMCCache
MEMCACHED_LOCATION=memcached:11211
MEMCACHED_LOCK_EXPIRE=3600
MEMCACHED_LOCK_TIMEOUT=10
MEMCACHED_OPTIONS=

# Maximum document size in MB
MAX_DOCUMENT_SIZE=200
CLIENT_RESULTS_LIMIT=5
API_LIMIT_PER_PAGE=1000

# GIS client
# Optional licensed basemap (XYZ template + attribution). Empty = OpenStreetMap.
# Example (requires your own key/terms): https://api.maptiler.com/maps/dataviz/{z}/{x}/{y}.png?key=YOUR_KEY
AVDP_BASEMAP_URL=
AVDP_BASEMAP_TITLE="Light basemap"
AVDP_BASEMAP_ATTRIBUTION=
# Style new vector uploads automatically (smart mapping); False keeps GeoServer's generic default
AVDP_AUTO_STYLE=True
GEONODE_CLIENT_LAYER_PREVIEW_LIBRARY=mapstore
MAPBOX_ACCESS_TOKEN=
GOOGLE_API_KEY=

# Other options
MODIFY_TOPICCATEGORY=True
AVATAR_GRAVATAR_SSL=True
EXIF_ENABLED=True
CREATE_LAYER=True
FAVORITE_ENABLED=True

# Advanced workflow (approval/publishing). Kept off for the first version;
# resources stay private through the anonymous permission defaults above.
RESOURCE_PUBLISHING=False
ADMIN_MODERATE_UPLOADS=False

HARVESTING_MONITOR_ENABLED=True
HARVESTING_MONITOR_DELAY=60

# Container restart policy
RESTART_POLICY_CONDITION="on-failure"
RESTART_POLICY_DELAY="5s"
RESTART_POLICY_MAX_ATTEMPTS="3"
RESTART_POLICY_WINDOW=120s

# Upload limits. 5368709120 bytes is the GeoNode default (5 GB); AVDP uses
# 1 GB as a safer starting point. The nginx client_max_body_size must allow it.
DEFAULT_MAX_UPLOAD_SIZE=1073741824
DEFAULT_MAX_PARALLEL_UPLOADS_PER_USER=5
PERMISSION_CACHE_EXPIRATION_TIME=3600
